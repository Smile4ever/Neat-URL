{
	"name": "Neat URL",
	"description": "__MSG_extensionDescription__",
	"homepage_url": "https://github.com/Smile4ever/Neat-URL",
	"manifest_version": 3,
	"version": "2026.10.24.2",
	"default_locale": "en",
	"icons": {
		"48": "icons/dark/neaturl-48.png",
		"96": "icons/dark/neaturl-96-state0.png"
	},
	"permissions": [
		"storage",
		"contextMenus",
		"tabs",
		"webRequest",
		"webRequestBlocking",
		"declarativeNetRequestWithHostAccess"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"options_ui": {
		"page": "options.html",
		"open_in_tab": true
	},
	"action": {
		"default_icon": "icons/dark/neaturl-96-state0.png",
		"theme_icons": [
			{
				"light": "icons/light/neaturl-96-state0.png",
				"dark": "icons/dark/neaturl-96-state0.png",
				"size": 96
			}
		],
		"default_title": "Neat URL"
	},
	"content_scripts": [
		{
			"matches": [
				"<all_urls>"
			],
			"js": [
				"src/core/domain.js",
				"src/core/params.js",
				"src/core/clean.js",
				"src/content/links.js"
			],
			"run_at": "document_start"
		}
	],
	"background": {
		"scripts": [
			"src/core/defaults.js",
			"src/core/domain.js",
			"src/core/params.js",
			"src/core/clean.js",
			"src/core/migrate.js",
			"src/core/sync.js",
			"src/background/common.js",
			"src/background/sync.js",
			"src/background/firefox.js"
		],
		"service_worker": "src/background/chrome-sw.js"
	},
	"browser_specific_settings": {
		"gecko": {
			"id": "neaturl@hugsmile.eu",
			"strict_min_version": "140.0",
			"data_collection_permissions": {
				"required": [
					"none"
				]
			}
		},
		"gecko_android": {
			"strict_min_version": "140.0"
		}
	},
	"minimum_chrome_version": "121"
}
